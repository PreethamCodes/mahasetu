PORT=8000
CORE_ENVIRONMENT=development

# Runtime database identity (scoped to the mahasetu schema), SQLAlchemy psycopg URL.
DATABASE_URL=
# Migration identity (schema creation and role administration), used only by alembic.
MIGRATION_DATABASE_URL=
SUPABASE_URL=

# Server credentials, at least 24 random characters each. Generate them; never commit real values.
# Held only by the MahaSetu website's server:
DASHBOARD_CLIENT_TOKEN=
# Keyed hash for one-time codes:
OTP_HASH_KEY=
# One token per registered requesting service: REQUESTER_TOKEN_<last part of credential_ref in capitals>.
# The seeded Scholarship service uses credential_ref secret-ref/scholarship.
REQUESTER_TOKEN_SCHOLARSHIP=

# Demonstration only: also return the one-time code in the API response so the website can show a banner.
# Refused when CORE_ENVIRONMENT=production.
OTP_DEMO_DISCLOSURE=disabled

# Department base URLs (optional; default to the endpoints stored in the provider_endpoints table).
REVENUE_URL=http://revenue-api:8001
EXAMINATION_URL=http://examination-api:8002
UNIVERSITY_URL=http://university-api:8003
# Department credentials, the same synthetic values each department is configured with.
REVENUE_USER=
REVENUE_PASSWORD=
EXAMINATION_API_KEY=
UNIVERSITY_CLIENT_ID=
UNIVERSITY_CLIENT_SECRET=

# Optional tuning (seconds unless noted): LAUNCH_TTL_SECONDS=1800 SESSION_TTL_SECONDS=3600
# AUTHORIZATION_TTL_SECONDS=1800 OTP_TTL_SECONDS=300 OTP_RESEND_SECONDS=30 PROVIDER_TIMEOUT_SECONDS=5 PROVIDER_ATTEMPTS=3
