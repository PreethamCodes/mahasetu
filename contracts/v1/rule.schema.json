{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rule",
  "type": "object",
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scheme_id": {
      "type": "string",
      "minLength": 1
    },
    "academic_year": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_field": {
      "enum": [
        "revenue.annual_income",
        "revenue.income_certificate_status",
        "revenue.caste_certificate_status",
        "revenue.certificate_issue_date",
        "revenue.certificate_expiry_date",
        "examination.ssc_marks",
        "examination.ssc_maximum_marks",
        "examination.ssc_result_status",
        "examination.intermediate_marks",
        "examination.intermediate_maximum_marks",
        "examination.intermediate_result_status",
        "university.registration_status",
        "university.programme",
        "university.department",
        "university.enrolment_status",
        "university.bonafide_validity"
      ]
    },
    "operator": {
      "enum": [
        "EQUALS",
        "NOT_EQUALS",
        "GREATER_THAN",
        "LESS_THAN",
        "GREATER_THAN_OR_EQUAL",
        "LESS_THAN_OR_EQUAL",
        "IN",
        "NOT_IN",
        "IS_PRESENT",
        "IS_VALID"
      ]
    },
    "expected_value": {},
    "severity": {
      "enum": [
        "REQUIRED",
        "ADVISORY"
      ]
    },
    "source_document": {
      "type": "string",
      "minLength": 1
    },
    "source_page": {
      "type": "integer",
      "minimum": 1
    },
    "source_section": {
      "type": "string",
      "minLength": 1
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "approval_status": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ]
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "approved_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "rule_id",
    "rule_name",
    "description",
    "scheme_id",
    "academic_year",
    "evidence_field",
    "operator",
    "expected_value",
    "severity",
    "source_document",
    "source_page",
    "source_section",
    "source_text",
    "effective_from",
    "effective_until",
    "version",
    "approval_status",
    "approved_by",
    "approved_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "approval_status": {
            "enum": [
              "APPROVED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string",
            "format": "uuid"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_status": {
            "enum": [
              "PENDING",
              "REJECTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "null"
          },
          "approved_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "IN",
              "NOT_IN"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "expected_value": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "IS_VALID",
              "IS_PRESENT"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "expected_value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "EQUALS",
              "NOT_EQUALS"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "expected_value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "GREATER_THAN",
              "LESS_THAN",
              "GREATER_THAN_OR_EQUAL",
              "LESS_THAN_OR_EQUAL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "expected_value": {
            "type": "number"
          }
        }
      }
    }
  ]
}
