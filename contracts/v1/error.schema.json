{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "error",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "INPUT",
        "AUTHENTICATION",
        "PERMISSION",
        "MISSING",
        "CONFLICT",
        "PROVIDER",
        "INTERNAL"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "transaction_reference": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_reference": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "code",
    "category",
    "message",
    "transaction_reference",
    "provider_reference",
    "retryable",
    "timestamp"
  ],
  "additionalProperties": false
}
