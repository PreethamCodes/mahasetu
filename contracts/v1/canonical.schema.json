{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canonical",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "minLength": 1
    },
    "source_student_reference": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_id": {
      "enum": [
        "revenue",
        "examination",
        "university"
      ]
    },
    "source_record_reference": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_updated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "transformation_version": {
      "type": "string",
      "minLength": 1
    },
    "validation_warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_status": {
      "enum": [
        "PRESENT",
        "MISSING",
        "INVALID",
        "EXPIRED",
        "UNAVAILABLE"
      ]
    },
    "evidence": {}
  },
  "required": [
    "student_id",
    "source_student_reference",
    "provider_id",
    "source_record_reference",
    "retrieved_at",
    "source_updated_at",
    "source_schema_version",
    "transformation_version",
    "validation_warnings",
    "evidence_status",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "provider_id": {
            "const": "revenue"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "object",
            "properties": {
              "annual_income": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "income_certificate_status": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "caste_certificate_status": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "certificate_issue_date": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "certificate_expiry_date": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "annual_income",
              "income_certificate_status",
              "caste_certificate_status",
              "certificate_issue_date",
              "certificate_expiry_date"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider_id": {
            "const": "examination"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "object",
            "properties": {
              "ssc_marks": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ssc_maximum_marks": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ssc_result_status": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "intermediate_marks": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "intermediate_maximum_marks": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "intermediate_result_status": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "ssc_marks",
              "ssc_maximum_marks",
              "ssc_result_status",
              "intermediate_marks",
              "intermediate_maximum_marks",
              "intermediate_result_status"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider_id": {
            "const": "university"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "object",
            "properties": {
              "registration_status": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "programme": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "department": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "enrolment_status": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bonafide_validity": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "registration_status",
              "programme",
              "department",
              "enrolment_status",
              "bonafide_validity"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
